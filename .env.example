# ==============================================================================
# PREPR - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit .env.local with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ API KEY
# ------------------------------------------------------------------------------
# Where to find it:
# 1. Go to: https://console.groq.com/keys
# 2. Sign up or log into your Groq Cloud account.
# 3. Click "Create API Key", provide a name (e.g. "prepr-app"), and copy the key (starts with "gsk_").
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Configuration (defaults to openai/gpt-oss-120b and openai/gpt-oss-20b)
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT URL
# ------------------------------------------------------------------------------
# Where to find it:
# 1. Go to: https://supabase.com/dashboard
# 2. Select your project.
# 3. Navigate to: Project Settings (gear icon bottom left) -> API
# 4. Under "Project URL", copy the URL (format: https://[your-project-ref].supabase.co).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------------------------
# 3. SUPABASE PUBLIC ANON KEY
# ------------------------------------------------------------------------------
# Where to find it:
# 1. In Supabase Dashboard: Project Settings -> API
# 2. Under "Project API keys", locate the key tagged "anon" and "public".
# 3. Click the copy icon to copy the JWT string.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVICE ROLE KEY (Server-Side Only)
# ------------------------------------------------------------------------------
# Where to find it:
# 1. In Supabase Dashboard: Project Settings -> API
# 2. Under "Project API keys", locate the key tagged "service_role" and "secret".
# 3. Click "Reveal" and copy the secret key.
# NOTE: This key bypasses Row Level Security and is only used in server routes.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
