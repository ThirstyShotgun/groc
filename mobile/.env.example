# ==============================================================================
# PREPR MOBILE - EXPO ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env or .env.local in the mobile/ directory.
# ==============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Groq API key for mock interview generation and live scoring
# NOTE: In production, API calls should be routed through a backend proxy
# rather than bundling the API key in client code.
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key_here
